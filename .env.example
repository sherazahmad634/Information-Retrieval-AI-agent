# ============================================================================
# IR-Agent — Environment Configuration
# Copy this file to `.env` and fill in your values.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development
APP_NAME=ir-agent
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Authentication (optional) ----------------------------------------------
# If set, all /api/v1/* endpoints require X-API-Key header.
API_KEY=

# --- Rate Limiting -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# --- LLM Provider (OpenAI-format API key required) --------------------------
# Provider: openai | anthropic | mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
OPENAI_API_KEY=
# Override to talk to Azure / Ollama / vLLM / llama.cpp (any OpenAI-compatible API).
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# Use a deterministic in-memory mock LLM (no network, useful for tests/demos).
MOCK_LLM=false

# --- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Reranker ----------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Vector Store ------------------------------------------------------------
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=./data/chroma
VECTOR_STORE_COLLECTION=ir_agent_docs

# --- Document Store ----------------------------------------------------------
DOCUMENT_STORE_PATH=./data/documents.db

# --- Ingestion ---------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_UPLOAD_SIZE_MB=25
SEED_CORPUS_PATH=./data/seed

# --- Retrieval ---------------------------------------------------------------
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
HYBRID_ALPHA=0.5
RRF_K=60

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
